POSTGRES_DB=hospital
POSTGRES_USER=hospital_app
POSTGRES_PASSWORD=hospital_app
POSTGRES_PORT=5432

APP_PORT=8080
FRONTEND_PORT=5173
# Use localhost consistently in the browser, callback URL and issuer.
KEYCLOAK_PORT=8180
KEYCLOAK_URL=http://localhost:8180
# Set explicitly if the front-end is reached using another public origin.
# MEDHEAD_PUBLIC_ORIGIN=http://localhost:5173
KEYCLOAK_DB_PASSWORD=medhead_identity
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=medhead_admin_demo
KEYCLOAK_CLIENT_SECRET=medhead_web_demo_secret
KEYCLOAK_LECTEUR_PASSWORD=lecteur_demo
KEYCLOAK_REGULATEUR_PASSWORD=regulateur_demo
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

REDIS_PASSWORD=medhead_redis
REDIS_MAXMEMORY=256mb
REDIS_STREAM_KEY=medhead:reservations
# Target length for XADD ... ACKED MAXLEN ~ (unacknowledged entries are kept).
REDIS_STREAM_MAXLEN=10000
REDIS_STREAM_CONSUMER_GROUPS=reservation-consumers
MEDHEAD_OUTBOX_ENABLED=true
MEDHEAD_OUTBOX_RETRY_DELAY=1000
MEDHEAD_OUTBOX_BATCH_SIZE=100

PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.test
PGADMIN_PASSWORD=admin
